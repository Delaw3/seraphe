NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=mongodb+srv://username:password@example.mongodb.net/seraphe?retryWrites=true&w=majority

# Redis
# Use either REDIS_URL or REDIS_HOST/REDIS_PORT.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Auth
JWT_SECRET=change-this-admin-secret
JWT_EXPIRES_IN=1d

# Payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Email (Brevo SMTP relay)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<BREVO_SMTP_LOGIN>
SMTP_PASS=<BREVO_SMTP_KEY>
MAIL_FROM=noreply@seraphebeauty.org
MAIL_FROM_NAME=Seraphe Beauty

FRONTEND_URL=https://seraphebeauty.org
